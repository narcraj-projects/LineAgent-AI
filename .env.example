# Configure integrations locally; a populated template is never committed.
# Configure real credentials locally only; never commit populated copies.
FIREWORKS_API_KEY=
# Use an accessible serverless chat model resource ID. Confirm via the catalog/API;
# example model IDs in provider docs may no longer be deployed. No implicit default.
FIREWORKS_MODEL=
# Embedding model is distinct from the chat/generation model.
FIREWORKS_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Optional trusted PEM CA bundle for this machine's TLS environment.
SSL_CERT_FILE=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional field overrides; otherwise use the unique matching schema field.
PINECONE_DENSE_FIELD=
PINECONE_TEXT_FIELD=
# Optional verified PDF packet; ingest it before enabling the UI's PDF namespace.
LINEMEDIC_PDF_MANIFEST=
SUPABASE_URL=
# Server-side only; accepts a backend sb_secret_ key or legacy service_role JWT.
# Never use a publishable/anon key here or send this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Optional migration-only database URI; the Streamlit REST adapter does not read it.
# This can contain a database password and must remain server-side and out of Git.
SUPABASE_DB_URL=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false
# Optional regional endpoint and workspace selection for multi-workspace keys.
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
MEM0_API_KEY=
# Railway provides PORT and RAILWAY_PUBLIC_DOMAIN. Other hosts can set these.
PORT=8080
LINEMEDIC_PUBLIC_DOMAIN=
LINEMEDIC_DEPLOYED=false
# Hosted demo gate: set both in Railway Variables; password at least 16 characters.
# This shared gate is not per-user authentication or GxP authorization.
LINEMEDIC_DEMO_USERNAME=
LINEMEDIC_DEMO_PASSWORD=
